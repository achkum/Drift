# Copy to .env.local. See docs/GOOGLE_SETUP.md.

# ── Google sync (Data Portability API) ──────────────────────────────
# OAuth 2.0 client (type: Web application) from Google Cloud console → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte AES-256-GCM key that encrypts the refresh token cookie.
# Generate: openssl rand -hex 32
# Rotating it disconnects every user.
DRIFT_TOKEN_KEY=

# Optional: public origin of the app (redirects + same-origin checks behind a proxy).
# DRIFT_APP_URL=https://drift.example.com

# Optional: override the OAuth redirect URI (default: <origin>/api/google/auth/callback).
# Must exactly match an Authorized redirect URI on the OAuth client.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/auth/callback

# 1 = mock mode: fake connect + export with a generated archive. No Google calls, no credentials.
# DRIFT_GOOGLE_MOCK=1

# 1 = do not mark cookies Secure even in production (only for http-only test deployments).
# DRIFT_INSECURE_COOKIES=1
